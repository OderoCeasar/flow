# Copy to app.env for running the API or worker outside Docker (`make run`).
ENVIRONMENT=local
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

DB_SOURCE=postgresql://flow:flow@localhost:5433/flow?sslmode=disable
MIGRATION_URL=file://db/migrations
HTTP_SERVER_ADDRESS=0.0.0.0:8081

# Leave empty locally (a public dev key is used). Required everywhere else.
TOKEN_SYMMETRIC_KEY=
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=720h
COOKIE_SECURE=false
DEV_OTP_ECHO=true

S3_ENDPOINT=localhost:9000
S3_PUBLIC_ENDPOINT=localhost:9000
S3_ACCESS_KEY=flowminio
S3_SECRET_KEY=flowminio-secret
S3_BUCKET=flow-photos
PHOTO_URL_DURATION=15m

# console | africastalking
SMS_PROVIDER=console
API_URL=https://api.sandbox.africastalking.com/version1/messaging
AFRICASTALKING_USERNAME=sandbox
SMS_SENDER_API_KEY=
SMS_SENDER_ID=

# stub | claude | off   and   keyword | claude | off
AI_IMAGE_CLASSIFIER=stub
AI_TEXT_CLASSIFIER=keyword
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

SEED_DEMO=true
WORKER_CONCURRENCY=4
RESCORE_INTERVAL=1h
